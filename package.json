{
  "name": "rush-epfl",
  "private": true,
  "version": "0.1.0",
  "description": "Rush — livraison communautaire entre membres de l'EPFL",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "RUSH_DEMO=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.19.17",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.9",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.43.0",
    "nodemailer": "^7.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4",
    "tsx": "^4.23.15",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^24.10.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
